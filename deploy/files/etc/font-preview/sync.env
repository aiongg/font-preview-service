# Read by fps-sync.service. deploy.sh index sets INDEX_COMMIT and INDEX_SHA256 (public values:
# a commit of the index repository and the sha256 of that commit's sources.json); setup creates
# this file only when it is missing.
INDEX_REPO=aiongg/craft-font-index
SYNC_THREADS=1
# SYNC_MEMORY_MB=
# SYNC_MAX_FAILED_PERCENT=
# SYNC_FORCE=
# Memory limit of the sync container (default 1g).
# SYNC_CONTAINER_MEMORY=1g
